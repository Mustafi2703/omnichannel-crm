# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/omnicrm?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
# Generate once with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=""

# AI (optional — rule-based fallback works without this)
# Generic OpenAI-compatible chat provider. These take precedence when set.
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_MODEL=""
LLM_PROVIDER=""

# NVIDIA NIM / Integrate API (chat only; uses the OpenAI-compatible endpoint)
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="nvidia/nemotron-3-super-120b-a12b"

# OpenAI chat only. Keep chat configuration separate from embeddings below.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Embeddings: select exactly one environment-specific provider/index.
# Staging: NVIDIA endpoint + exact model/dimension + staging-v1.
# Production: OpenAI text-embedding-3-small + 1536 + production-v1.
EMBEDDING_PROVIDER=""
EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL=""
EMBEDDING_MODEL=""
EMBEDDING_DIMENSIONS=""
EMBEDDING_INDEX_VERSION=""

# Soft monthly OpenAI spend cap in USD. When exceeded, AI falls back to rule replies.
AI_MONTHLY_BUDGET_USD="40"

# AiSensy WhatsApp via the Project API (PRO plan; demo mode without these).
# Project ID and password come from a Custom App in AiSensy; the secret is the webhook's shared secret.
AISENSY_PROJECT_ID=""
AISENSY_PROJECT_API_PWD=""
AISENSY_WEBHOOK_SECRET=""
DEFAULT_TENANT_SLUG="demo-sirket"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production: https://eacrm.net
REDIS_URL="redis://127.0.0.1:6379"
RESEND_API_KEY=""
# Use only after eacrm.net is verified in Resend.
RESEND_FROM="EA Global Water <support@eacrm.net>"
WIDGET_ALLOWED_ORIGINS="https://www.hidrotekwater.com.tr,https://hidrotekwater.com.tr,https://www.biohidrogen.com,https://biohidrogen.com"
