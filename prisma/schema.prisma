generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  AGENT
}

enum LeadSource {
  website
  whatsapp
  google_ads
  manual
  referral
}

enum ConversationStatus {
  open
  pending
  closed
}

enum MessageDirection {
  inbound
  outbound
}

enum SenderType {
  contact
  agent
  bot
  system
}

enum TaskStatus {
  open
  done
  cancelled
}

enum AiMode {
  auto
  suggest
  off
}

model Tenant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  timezone      String   @default("Europe/Istanbul")
  localeDefault String   @default("tr")
  settings      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users           User[]
  contacts        Contact[]
  leads           Lead[]
  conversations   Conversation[]
  pipelineStages  PipelineStage[]
  tasks           Task[]
  knowledgeDocs   KnowledgeDocument[]
  knowledgeChunks KnowledgeChunk[]
  knowledgeIndexes KnowledgeIndex[]
  usageEvents     UsageEvent[]
  rateCard        RateCard?
  budgetPolicy    BudgetPolicy?
  messages        Message[]
  attachments     Attachment[]
  auditLogs       AuditLog[]
  integrations    IntegrationConnection[]
  notifications   Notification[]
  automationRules AutomationRule[]
  automationRuns  AutomationRun[]
  calendarEvents  CalendarEvent[]
  whatsappTemplates WhatsappTemplate[]
  campaigns       Campaign[]
  campaignRecipients CampaignRecipient[]
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  role         Role      @default(AGENT)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownedContacts    Contact[]      @relation("ContactOwner")
  ownedLeads       Lead[]         @relation("LeadOwner")
  assignedConvos   Conversation[] @relation("ConvoAssignee")
  assignedTasks    Task[]         @relation("TaskAssignee")
  sentMessages     Message[]
  auditLogs        AuditLog[]
  calendarEvents   CalendarEvent[] @relation("EventOwner")

  @@unique([tenantId, email])
}

model PipelineStage {
  id        String  @id @default(cuid())
  tenantId  String
  key       String
  name      String
  nameTr    String
  position  Int
  isWon     Boolean @default(false)
  isLost    Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@unique([tenantId, key])
}

model Contact {
  id                      String     @id @default(cuid())
  tenantId                String
  displayName             String
  companyName             String?
  email                   String?
  phone                   String?
  city                    String?
  source                  LeadSource @default(manual)
  consentWhatsappMarketing Boolean   @default(false)
  utmSource               String?
  utmMedium               String?
  utmCampaign             String?
  gclid                   String?
  landingUrl              String?
  ownerUserId             String?
  metadata                Json       @default("{}")
  automationPausedAt      DateTime?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner         User?          @relation("ContactOwner", fields: [ownerUserId], references: [id])
  identities    ContactIdentity[]
  leads         Lead[]
  conversations Conversation[]
  tasks         Task[]
  calendarEvents CalendarEvent[]
  campaignRecipients CampaignRecipient[]

  @@index([tenantId, phone])
  @@index([tenantId, email])
}

model ContactIdentity {
  id        String @id @default(cuid())
  tenantId  String
  contactId String
  type      String
  value     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, value])
}

model Lead {
  id              String     @id @default(cuid())
  tenantId        String
  contactId       String
  stageId         String
  title           String
  score           Int        @default(0)
  source          LeadSource @default(manual)
  ownerUserId     String?
  nextFollowupAt  DateTime?
  expectedValue   Float?
  wonAmount       Float?
  attributedCost  Float      @default(0)
  lostReason      String?
  tags            String[]   @default([])
  notes           String?
  qualification   Json       @default("{}")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stage   PipelineStage @relation(fields: [stageId], references: [id])
  owner   User?         @relation("LeadOwner", fields: [ownerUserId], references: [id])
  tasks   Task[]
  calendarEvents CalendarEvent[]

  @@index([tenantId, stageId])
  @@index([tenantId, nextFollowupAt])
}

model Conversation {
  id           String             @id @default(cuid())
  tenantId     String
  contactId    String
  channelType  String             @default("website")
  status       ConversationStatus @default(open)
  assigneeId   String?
  assignedAt   DateTime?
  unassignedAt DateTime?
  lastCallAt   DateTime?
  unassignedEscalatedAt DateTime?
  firstCallEscalatedAt  DateTime?
  threeHourEscalatedAt  DateTime?
  lastMessageAt DateTime          @default(now())
  aiMode       AiMode             @default(auto)
  handoffAt    DateTime?
  externalThreadId String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee User?     @relation("ConvoAssignee", fields: [assigneeId], references: [id])
  messages Message[]
  tasks    Task[]
  attachments Attachment[]
  calendarEvents CalendarEvent[]

  @@index([tenantId, status, lastMessageAt])
}

model Message {
  id                String           @id @default(cuid())
  tenantId          String
  conversationId    String
  direction         MessageDirection
  senderType        SenderType
  senderUserId      String?
  bodyText          String
  externalMessageId String?
  aiMeta            Json?
  deliveryStatus    String           @default("sent")
  deliveryError     String?
  createdAt         DateTime         @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser   User?        @relation(fields: [senderUserId], references: [id])
  attachments  Attachment[]

  @@unique([tenantId, externalMessageId])
  @@index([conversationId, createdAt])
}

model Task {
  id           String     @id @default(cuid())
  tenantId     String
  type         String     @default("follow_up")
  leadId       String?
  contactId    String?
  conversationId String?
  title        String
  body         String?
  assigneeId   String?
  dueAt        DateTime?
  dueNotifiedAt DateTime?
  status       TaskStatus @default(open)
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead     Lead?  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignee User?  @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([tenantId, status, dueAt])
  @@index([status, dueNotifiedAt, dueAt])
  @@index([tenantId, contactId])
  @@index([tenantId, conversationId])
}

model Attachment {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  messageId      String?
  filename       String
  contentType    String
  storageKey     String
  sizeBytes      Int
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([tenantId, conversationId])
}

model Notification {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  type        String
  title       String
  body        String?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt])
  @@index([tenantId, userId, createdAt])
}

model AutomationRule {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  trigger   String
  action    String
  config    Json     @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   AutomationRun[]
  @@index([tenantId, trigger, isActive])
}

model AutomationRun {
  id        String   @id @default(cuid())
  tenantId  String
  ruleId    String
  status    String
  detail    Json     @default("{}")
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  @@index([tenantId, createdAt])
}

model CalendarEvent {
  id             String   @id @default(cuid())
  tenantId       String
  title          String
  description    String?
  startsAt       DateTime
  endsAt         DateTime?
  leadId         String?
  contactId      String?
  conversationId String?
  ownerUserId    String?
  reminderAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  owner        User?         @relation("EventOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, startsAt])
  @@index([tenantId, reminderAt])
}

model WhatsappTemplate {
  id               String   @id @default(cuid())
  tenantId         String
  providerTemplateId String?
  name             String
  language         String   @default("tr")
  category         String   @default("marketing")
  status           String   @default("draft")
  body             String
  variables        Json     @default("[]")
  buttons          Json     @default("[]")
  ownerUserId      String?
  rejectionReason  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([tenantId, name, language])
  @@index([tenantId, status])
}

model Campaign {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  templateId  String
  status      String   @default("draft")
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdById String?
  audience    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template   WhatsappTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  recipients CampaignRecipient[]

  @@index([tenantId, status, scheduledAt])
}

model CampaignRecipient {
  id          String   @id @default(cuid())
  tenantId    String
  campaignId  String
  contactId   String
  status      String   @default("queued")
  attempts    Int      @default(0)
  nextAttemptAt DateTime?
  sendingAt   DateTime?
  externalMessageId String?
  error       String?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  clickedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([tenantId, status, nextAttemptAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
}

model IntegrationConnection {
  id                String   @id @default(cuid())
  tenantId          String
  provider          String
  encryptedConfig   String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
}

model KnowledgeDocument {
  id             String           @id @default(cuid())
  tenantId       String
  title          String
  content        String
  sourceFilename String?
  mimeType       String?
  // Keep existing seeded/imported documents visible. New uploads explicitly start
  // in `processing` in the API while their embeddings are generated.
  status         String           @default("ready")
  errorMessage   String?
  embeddingModel String?
  embeddingIndexId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  embeddingIndex KnowledgeIndex? @relation(fields: [embeddingIndexId], references: [id], onDelete: SetNull)
  chunks KnowledgeChunk[]

  @@index([tenantId, status])
  @@index([tenantId, embeddingIndexId])
}

model KnowledgeIndex {
  id         String   @id @default(cuid())
  tenantId   String
  provider   String
  model      String
  dimensions Int
  version    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents KnowledgeDocument[]
  chunks    KnowledgeChunk[]

  @@unique([tenantId, provider, model, dimensions, version])
  @@index([tenantId, isActive])
}

model KnowledgeChunk {
  id         String   @id
  tenantId   String
  documentId String
  indexId    String
  content    String
  tokenCount Int
  metadata   Json     @default("{}")
  embedding  Unsupported("vector")
  createdAt  DateTime @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  index    KnowledgeIndex    @relation(fields: [indexId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId])
  @@index([tenantId, indexId, documentId])
}

model UsageEvent {
  id          String   @id @default(cuid())
  tenantId    String
  category    String
  eventType   String
  quantity    Float    @default(1)
  unitCost    Float    @default(0)
  totalCost   Float    @default(0)
  leadId      String?
  meta        Json     @default("{}")
  occurredAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt])
  @@index([tenantId, category])
}

model RateCard {
  id              String @id @default(cuid())
  tenantId        String @unique
  openaiPer1kIn   Float  @default(0.15)
  openaiPer1kOut  Float  @default(0.6)
  whatsappMsg     Float  @default(0.005)
  emailMsg        Float  @default(0.001)
  vpsPerDay       Float  @default(0.8)
  adsSpendPerDay  Float  @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BudgetPolicy {
  id             String @id @default(cuid())
  tenantId       String @unique
  dailyCap       Float  @default(50)
  monthlyCap     Float  @default(800)
  warnAtPercent  Int    @default(70)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
