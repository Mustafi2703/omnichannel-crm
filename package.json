{
  "name": "omnichannel-crm",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0",
    "worker": "tsx src/worker.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "tenant:provision": "tsx scripts/provision-client-tenant.ts",
    "embeddings:prepare": "tsx scripts/prepare-embedding-index.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/pdf-parse": "^1.1.5",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.1.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.7",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.30.0",
    "mammoth": "^1.12.1",
    "next": "^15.5.21",
    "openai": "^7.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.19.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.21",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}
